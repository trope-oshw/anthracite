		(uuid "8f11b841-f4d8-4e2f-80de-0917f8753bad")
	)
	(text "U107 must be HCT, not HC. It runs on +5 V, but 3.3 V MCU GPIO or TIM\ndrive its inputs directly. HC thresholds scale with VCC and 3.3 V does\nnot reach them at 5 V. HC and HCT are pin- and function-compatible,\nso the substitution looks harmless on the schematic but will not work."
		(exclude_from_sim no)
		(at 229.108 184.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ad001433-1676-4cdc-b94f-729e41c08aff")
	)
	(text "FootSW"
		(exclude_from_sim no)
		(at 403.606 40.386 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b8d3db37-ff6b-4b4e-ab74-1b94a4426665")
	)
	(text "MIDI OUT / EXP-SW IN"
		(exclude_from_sim no)
		(at 247.142 246.888 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bff51db1-0b38-4404-af67-ec3e838db63d")
	)
	(text "Reset"
		(exclude_from_sim no)
		(at 201.676 19.304 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c139872e-7f68-49da-976e-36941a9f7aa2")
	)
	(text "J104's function is determined by\nthe state of PB5 (GPIO_OUTPUT).\nPB5 = H: EXP-SW (latch) Mode\nPB5 = L: MIDI-OUT Mode \n    (MIDI TRS Type A compliant)"
		(exclude_from_sim no)
		(at 238.252 262.382 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e2917d28-d731-4c55-9e3e-d988a5c06498")
	)
