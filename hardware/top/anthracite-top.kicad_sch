	(text "Bias adds resistance in parallel with Q13's collector \nload via Q14/Q15.\n(Toggle-Switch Pos.) = [Q14, Q15, Rc(eff), Headroom ratio]\nCenter = [OFF, OFF, 8.6k, 1:1]\nOffset = [ON,  OFF, 5.6k, 2:1]\nSkew   = [OFF,  ON, 4.3k, 3:1]\nX-Skew = [ON,   ON, 3.4k, 4:1]\n(Headroom ratio = V(C13)-V(E13) : VCC-V(C13))"
		(exclude_from_sim no)
		(at 213.36 78.994 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
